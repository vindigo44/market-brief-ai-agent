# Clé API Gemini (obligatoire pour le résumé IA ; sinon, fallback local).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
REPORT_LANGUAGE=fr

# --- Email (optionnel) : envoi du rapport à chaque exécution ---
# Gmail : SMTP_USER = ton adresse, SMTP_PASSWORD = un "App Password" (2FA requise).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Destinataire(s), séparés par des virgules. Vide = envoi à SMTP_USER.
EMAIL_TO=
# Expéditeur affiché. Vide = SMTP_USER.
EMAIL_FROM=
