# Clé API Gemini (obligatoire pour le résumé IA ; sinon, fallback local).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
REPORT_LANGUAGE=fr

# --- Telegram (optionnel) : envoi du rapport à chaque exécution ---
# TELEGRAM_BOT_TOKEN : jeton donné par @BotFather (ex. 123456:ABC-def...)
# TELEGRAM_CHAT_ID   : identifiant de la conversation cible (voir README)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
